{
  "name": "md-reader",
  "version": "0.1.0",
  "private": true,
  "description": "本地优先的 Markdown 阅读器，顺带能写",
  "type": "module",
  "packageManager": "pnpm@11.28.5",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch packages/server/src/index.ts --no-open",
    "dev:web": "vite --config packages/web/vite.config.ts",
    "build": "node packages/web/node_modules/vite/bin/vite.js build --config packages/web/vite.config.ts",
    "package": "node scripts/package-sea.mjs",
    "upx:fetch": "node scripts/fetch-upx.mjs",
    "start": "node packages/server/src/index.ts",
    "test": "node --test \"packages/server/test/*.test.ts\" \"packages/web/test/*.test.ts\"",
    "typecheck": "tsc -p packages/server/tsconfig.json && tsc -p packages/web/tsconfig.json"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "1.0.0-alpha.6",
    "resedit": "^3.1.0",
    "typescript": "^5.9.2"
  }
}
